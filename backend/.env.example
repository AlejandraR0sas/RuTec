# Copiar a .env (NUNCA subir .env al repo)
PORT=3000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/rutec
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
# Ruta del ejecutable de SWI-Prolog (si no está en el PATH)
SWIPL_PATH=swipl
# Cuántas solicitudes iguales hacen que el admin vea la ruta como "sugerida"
UMBRAL_SOLICITUDES=10
# Datos del admin que crea `npm run seed:admin`
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@rutec.local
ADMIN_PASSWORD=cambia-esta-contraseña
